<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentyellow.ai-operator.executor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "__AI_OPERATOR_ROOT__" &amp;&amp; export AI_OPERATOR_ROOT="__AI_OPERATOR_ROOT__" &amp;&amp; /usr/bin/python3 control_plane/scripts/08_run_assigned_jobs.py &gt;&gt; "__AI_OPERATOR_ROOT__/logs/executor.log" 2&gt;&amp;1</string>
