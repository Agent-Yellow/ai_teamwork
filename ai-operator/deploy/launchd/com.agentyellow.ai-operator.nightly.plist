<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agentyellow.ai-operator.nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "__AI_OPERATOR_ROOT__" &amp;&amp; export AI_OPERATOR_ROOT="__AI_OPERATOR_ROOT__" &amp;&amp; /usr/bin/python3 control_plane/scripts/03_nightly_consolidation.py &gt;&gt; "__AI_OPERATOR_ROOT__/logs/nightly.log" 2&gt;&amp;1</string>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
</dict>
</plist>
