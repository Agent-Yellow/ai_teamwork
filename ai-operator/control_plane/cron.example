# AI_OPERATOR_ROOT should point at the ai-operator directory.
# Example:
# export AI_OPERATOR_ROOT="$HOME/ai_teamwork/ai-operator"

# Mac primary: supervisor logic every 3 minutes
*/3 * * * * cd "$AI_OPERATOR_ROOT" && python3 control_plane/scripts/02_heartbeat.py >> "$AI_OPERATOR_ROOT/logs/heartbeat.log" 2>&1

# Mac primary: execute any assigned local or remote jobs every minute
* * * * * cd "$AI_OPERATOR_ROOT" && python3 control_plane/scripts/08_run_assigned_jobs.py >> "$AI_OPERATOR_ROOT/logs/executor.log" 2>&1

# Mac primary: nightly consolidation
0 2 * * * cd "$AI_OPERATOR_ROOT" && python3 control_plane/scripts/03_nightly_consolidation.py >> "$AI_OPERATOR_ROOT/logs/nightly.log" 2>&1
